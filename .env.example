# Local lab only. Copy to .env if you need to override defaults.
LAB_PORT=8080
LAB_SEED_COUNT=100000
LAB_CACHE_STRATEGY=snapshot
LAB_SYNC_STRATEGY=journal
LAB_REFRESH_INTERVAL=10s
LAB_BATCH_SIZE=1000
SPRING_PROFILES_ACTIVE=default
DB_PASSWORD=local-lab-password
DB_ROOT_PASSWORD=local-root-password

JAVA_VERSION=25
LAB_VIRTUAL_THREADS=false
DOTNET_VERSION=10.0
LAB_CPUS=4
LAB_MEMORY=2g
JAKARTA_PORT=8081
DOTNET_PORT=8082
